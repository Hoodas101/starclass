# ========================================
# 星课 StarClass · 后端环境变量示例
# 复制为 backend/.env 后由进程管理器注入，或直接 export
# （本系统不自动读取 .env 文件，需通过 shell / systemd / launchd / PM2 注入）
# ========================================

# ─── 安全（生产建议显式配置）───
# JWT 签名密钥。未设置时系统首次启动自动生成强随机密钥并持久化到
# backend/db/.jwt-secret（随数据库一起备份即可）；
# 多实例部署 / 需要密钥可控时显式设置共享值。
# 生成方式：openssl rand -hex 32
JWT_SECRET=

# ─── 服务 ───
# 监听端口，默认 3001（管理后台静态页与 API 同端口单入口）
PORT=3001

# 数据库文件路径，默认 backend/db/data.db（单文件 SQLite）
# 注意：启用 WAL 后运行期间还有 data.db-wal / data.db-shm 两个附属文件，
# 迁移或备份请用 `bash tools/backup.sh`（内部走 sqlite3 .backup），不要直接 cp data.db
# DB_PATH=/var/lib/starclass/data.db

# ─── 备份异地副本（可选，生产强烈建议）───
# 本地备份完整性校验通过后，额外复制一份到该目录（同名文件）。
# 目的：本地备份默认与数据库同盘（DB_PATH 同级 backups/），单盘损坏即全丢；
# 请指向**另一块物理盘 / 独立挂载点 / NFS**，不要填同卷子目录。
# 未设置时不复制；目录不存在会自动创建；复制失败仅打日志，不影响备份与业务主流程。
# BACKUP_OFFSITE_DIR=/mnt/offsite-backups

# ─── 时区 ───
# 决定「今日/本月」的日切分口径。不设置时按系统时区；Docker 镜像默认 Asia/Shanghai。
# TZ=Asia/Shanghai

# ─── 登录与安全策略 ───
# 家长「手机号免密登录」开关：生产默认关闭，开发/测试默认开启；设为 true 才允许家长凭手机号登录。
# PARENT_PHONE_LOGIN=true

# 员工新增账号与重置密码的初始密码，默认 123456；建议机构上线前改为自定义值。
# STAFF_DEFAULT_PASSWORD=123456

# 家长端「模拟支付」自助通道（家长自行把订单标记为已支付）。
# 生产环境默认关闭（fail-closed）：真实微信支付未接通前，放开该通道等于允许零成本下单。
# 仅本地演示/开发需要时设为 0 显式放开；接入微信支付后请保持关闭。
# SIMULATED_PAY_DISABLED=0

# ─── 反向代理 ───
# 可信代理跳数（通常 1）。不设置时 req.ip 恒为反代地址，全体用户共享同一个限流桶
# （可被单点打满锁死全站登录），审计日志 IP 维度也会失真。
#
# 用 ./deploy/deploy.sh（Caddy 边车）时**无需手动设置**：docker-compose.caddy.yml
# 已为 app 服务默认注入 TRUST_PROXY=1，可用同名环境变量覆盖（如前置云负载均衡时设为 2）。
# 用 Nginx 等自建反代时，请在此显式设置：
# TRUST_PROXY=1
#
# 仅接受正整数跳数。0 / 负数 / 非数字（如 yes）一律按「不信任任何代理头」处理并打印告警 ——
# 绝不会回退为「信任全部代理」，那会让 X-Forwarded-For 可被伪造以绕过限流。

# ─── 微信小程序登录 / 订阅消息（不配置则相关功能自动降级为站内信）───
WX_APPID=
WX_SECRET=

# ─── 跨域（Web 管理端与后端同端口托管时无需配置）───
# 仅当管理端独立部署到其他域名时设置，逗号分隔；未配置时拒绝所有跨域
# CORS_ORIGINS=https://admin.yourdomain.com

# ─── 限流（一般不动）───
# RATE_MAX=500
# LOGIN_RATE_LIMIT=100

# ─── 微信支付（可选，未启用时忽略）───
# WX_MCH_ID=
# WX_MCH_KEY=
# WX_NOTIFY_URL=
