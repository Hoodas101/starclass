{
  "name": "starclass",
  "version": "1.0.3",
  "description": "星课 StarClass — 教培/健身机构一体化管理系统：Web 管理后台 + API，Node.js + Express + SQLite 私有化部署（可选付费三端小程序）",
  "private": true,
  "scripts": {
    "start": "bash start-all.sh",
    "start:backend": "cd backend && npm start",
    "init:db": "cd backend && node db/init.js",
    "seed": "cd backend && node db/seed.js",
    "seed:force": "cd backend && node db/seed.js --force",
    "dev:web": "cd web-admin && npm run dev",
    "build:web": "cd web-admin && npm run build",
    "smoke": "node smoke-test.mjs",
    "test": "node backend/tests/run-all.cjs",
    "test:backend": "node backend/tests/full-system.test.js",
    "verify": "node tools/verify-all.mjs",
    "install:all": "cd backend && npm install && cd ../web-admin && npm install"
  },
  "dependencies": {},
  "devDependencies": {},
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hoodas101/starclass.git"
  },
  "author": "Hoodas101",
  "license": "MIT"
}
